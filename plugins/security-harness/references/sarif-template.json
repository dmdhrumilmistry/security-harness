{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "security-harness",
          "informationUri": "https://github.com/dmdhrumilmistry/security-harness",
          "version": "0.1.0",
          "rules": [
            {
              "id": "SH-SQLI",
              "name": "SqlInjection",
              "shortDescription": { "text": "SQL Injection" },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "properties": { "tags": ["security", "external/cwe/cwe-89", "OWASP-A03"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SH-SQLI",
          "level": "error",
          "message": { "text": "EXAMPLE result. The reporter replaces this array; see mapping notes below." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/db/users.py" },
                "region": { "startLine": 42 }
              }
            }
          ],
          "partialFingerprints": { "shFindingId": "SH-SQLI-001" },
          "properties": {
            "security-severity": "9.8",
            "cwe": ["CWE-89"],
            "owasp": ["A03:2021-Injection"],
            "shStatus": "verified",
            "shConfidence": 90
          }
        }
      ]
    }
  ]
}

